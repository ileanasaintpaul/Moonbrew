<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menu.uss" />
    <Style src="Hud.uss" />
    <Style src="CharacterCreation.uss" />
    <!-- Character creation, after the Fantasy Menus creation screens: tabs along the top, a framed panel on the left,
         the owner on the right, drawn by the scene's camera behind this transparent panel. -->
    <ui:VisualElement name="creation" class="creation">
        <ui:VisualElement class="menu-fade" picking-mode="Ignore" />
        <ui:VisualElement class="tabs">
            <ui:Label class="tabs__key" text="Q" picking-mode="Ignore" />
            <ui:Button name="random" class="tab tab--action" text="Random" />
            <ui:Button name="tab-body" class="tab" text="Body" />
            <ui:Button name="tab-hair" class="tab" text="Hair" />
            <ui:Button name="tab-beard" class="tab" text="Beard" />
            <ui:Button name="tab-hat" class="tab" text="Hat" />
            <ui:Button name="tab-accessory" class="tab" text="Accessory" />
            <ui:Button name="tab-outfit" class="tab" text="Outfit" />
            <ui:Button name="tab-name" class="tab" text="Name" />
            <ui:Label class="tabs__key" text="E" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement class="window creation__panel">
            <ui:VisualElement class="window__lip" picking-mode="Ignore" />
            <ui:VisualElement class="window__frame" picking-mode="Ignore" />
            <ui:Label name="panel-title" class="window__title creation__title" picking-mode="Ignore" />

            <ui:VisualElement name="parts" class="parts">
                <ui:VisualElement name="grid" class="grid" />
                <ui:VisualElement name="part-colour-section" class="part-colours">
                    <ui:Label name="part-colour-title" class="colours__name" picking-mode="Ignore" />
                    <ui:VisualElement name="part-colours" class="swatches" />
                </ui:VisualElement>
                <ui:Label name="counter" class="creation__counter" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:VisualElement name="outfit" class="colours">
                <ui:Label class="colours__name" text="Top" picking-mode="Ignore" />
                <ui:VisualElement name="top-colours" class="swatches swatches--outfit" />
                <ui:Label class="colours__name" text="Bottom" picking-mode="Ignore" />
                <ui:VisualElement name="bottom-colours" class="swatches swatches--outfit" />
            </ui:VisualElement>

            <ui:VisualElement name="finish" class="finish">
                <ui:TextField name="owner-name" class="name-field" />
                <ui:Button name="start" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore" />
                    <ui:Label class="menu-item__label" text="Start" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="back" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore" />
                    <ui:Label class="menu-item__label" text="Back" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="selection" class="creation__selection" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
