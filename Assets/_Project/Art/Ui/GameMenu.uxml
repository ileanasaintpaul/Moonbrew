<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="game-menu" class="menu">
        <ui:VisualElement class="window menu__window">
            <ui:VisualElement class="window__lip" picking-mode="Ignore" />
            <ui:VisualElement class="window__frame" picking-mode="Ignore" />
            <ui:Label class="window__title" text="Recipe Book" />
            <ui:Label name="hint" class="window__band" />
            <!-- One banner per tab; only Recipes for now (map, relations... will join). -->
            <ui:VisualElement name="tabs" class="menu__tabs">
                <ui:Button name="tab-recipes" class="banner menu__tab menu__tab--active" text="Recipes">
                    <ui:VisualElement class="banner__frame" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:ScrollView name="content" class="menu__content" />
            <ui:Button name="close" class="menu__close" text="×" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
