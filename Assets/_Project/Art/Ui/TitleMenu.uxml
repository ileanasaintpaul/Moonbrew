<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menu.uss" />
    <ui:VisualElement name="title-menu" class="title-menu">
        <!-- Night sky: a pixel-art moon and clouds (Pixabay, kept at one texel per art pixel and drawn at whole multiples),
             rings of light round the moon; stars are added from code. -->
        <ui:VisualElement name="sky" class="sky" picking-mode="Ignore">
            <ui:VisualElement name="stars" class="stars" picking-mode="Ignore" />
            <ui:VisualElement class="halo halo--outer" picking-mode="Ignore" />
            <ui:VisualElement class="halo halo--inner" picking-mode="Ignore" />
            <ui:VisualElement class="cloud cloud--slope cloud--far cloud--flipped" style="left: 6px; top: 158px;" picking-mode="Ignore" />
            <ui:VisualElement class="cloud cloud--wide cloud--far" style="left: 488px; top: 52px;" picking-mode="Ignore" />
            <ui:VisualElement class="cloud cloud--slope cloud--back" style="left: 160px; top: 104px;" picking-mode="Ignore" />
            <ui:VisualElement class="moon" picking-mode="Ignore" />
            <!-- In front of the moon, hiding its lower right edge. -->
            <ui:VisualElement class="cloud cloud--wide cloud--back cloud--flipped" style="left: 318px; top: 112px;" picking-mode="Ignore" />
            <!-- Front bank: the two shapes alternate, the ones further forward lighter. -->
            <ui:VisualElement class="cloud-bank" picking-mode="Ignore">
                <ui:VisualElement class="cloud cloud--wide cloud--bank-back" style="left: -40px; top: 8px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--wide cloud--bank-back cloud--flipped" style="left: 250px; top: 4px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--wide cloud--bank-back" style="left: 540px; top: 10px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--slope cloud--front" style="left: 118px; top: 20px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--slope cloud--front cloud--flipped" style="left: 420px; top: 18px;" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="title-screen" class="screen title-screen">
            <ui:Label class="logo" text="Moonbrew" picking-mode="Ignore" />
            <ui:Label name="prompt" class="prompt" text="Click or press any key" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="main-screen" class="screen main-screen">
            <ui:VisualElement class="menu-fade" picking-mode="Ignore" />
            <ui:Label class="logo logo--small" text="Moonbrew" picking-mode="Ignore" />
            <ui:VisualElement class="menu-items">
                <ui:Button name="continue" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore" />
                    <ui:Label class="menu-item__label" text="Continue" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="new-game" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore" />
                    <ui:Label class="menu-item__label" text="New Game" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="load" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore" />
                    <ui:Label class="menu-item__label" text="Load Game" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="settings" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore" />
                    <ui:Label class="menu-item__label" text="Settings" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="quit" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore" />
                    <ui:Label class="menu-item__label" text="Quit" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="load-screen" class="screen panel-screen">
            <ui:VisualElement class="panel">
                <ui:Label class="panel__title" text="Load Game" picking-mode="Ignore" />
                <ui:ScrollView name="games" class="games" />
                <ui:Label name="no-games" class="games__empty" text="No saved game yet." picking-mode="Ignore" />
                <ui:Button name="load-back" class="menu-item menu-item--back" text="Back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settings-screen" class="screen panel-screen">
            <ui:VisualElement class="panel">
                <ui:Label class="panel__title" text="Settings" picking-mode="Ignore" />
                <ui:VisualElement class="setting">
                    <ui:Label class="setting__name" text="Fullscreen" picking-mode="Ignore" />
                    <ui:Button name="fullscreen" class="setting__value" />
                </ui:VisualElement>
                <ui:VisualElement class="setting">
                    <ui:Label class="setting__name" text="Resolution" picking-mode="Ignore" />
                    <ui:VisualElement class="setting__choice">
                        <ui:Button name="resolution-previous" class="setting__arrow" text="&lt;" />
                        <ui:Label name="resolution" class="setting__current" picking-mode="Ignore" />
                        <ui:Button name="resolution-next" class="setting__arrow" text="&gt;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="setting">
                    <ui:Label class="setting__name" text="Pixel rendering" picking-mode="Ignore" />
                    <ui:Button name="pixel-mode" class="setting__value" />
                </ui:VisualElement>
                <ui:Button name="settings-back" class="menu-item menu-item--back" text="Back" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
