<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menu.uss" />
    <ui:VisualElement name="title-menu" class="title-menu">
        <!-- Night sky after a pixel-art moonlit sky: rings of light round the moon, layered clouds with a light rim.
             Drawn with rounded elements that the pixel rendering turns into pixel art; stars are added from code. -->
        <ui:VisualElement name="sky" class="sky" picking-mode="Ignore">
            <ui:VisualElement name="stars" class="stars" picking-mode="Ignore" />
            <ui:VisualElement class="halo halo--outer" picking-mode="Ignore" />
            <ui:VisualElement class="halo halo--inner" picking-mode="Ignore" />
            <!-- Clouds: each bank is a row of round bumps on a long base, each bump with its own light rim. -->
            <ui:VisualElement class="clouds" picking-mode="Ignore">
            <ui:VisualElement class="cloud-bank" style="left: -10px; top: 118px;" picking-mode="Ignore">
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: -24px; top: 22px; width: 80px; height: 80px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: 34px; top: 0px; width: 92px; height: 92px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: 104px; top: 26px; width: 74px; height: 74px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: 156px; top: 44px; width: 62px; height: 62px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--base" style="left: -20px; top: 52px; width: 250px; height: 56px;" picking-mode="Ignore" />
            </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="moon" picking-mode="Ignore">
                <ui:VisualElement class="moon__spot moon__spot--large" picking-mode="Ignore" />
                <ui:VisualElement class="moon__spot moon__spot--medium" picking-mode="Ignore" />
                <ui:VisualElement class="moon__spot moon__spot--small" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- In front of the moon, hiding its lower right edge. -->
            <ui:VisualElement class="clouds" picking-mode="Ignore">
            <ui:VisualElement class="cloud-bank" style="left: 338px; top: 92px;" picking-mode="Ignore">
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: 0px; top: 42px; width: 60px; height: 60px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: 44px; top: 20px; width: 82px; height: 82px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: 112px; top: 0px; width: 104px; height: 104px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: 196px; top: 24px; width: 92px; height: 92px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--bump" style="left: 252px; top: 44px; width: 72px; height: 72px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--back cloud--base" style="left: 0px; top: 60px; width: 330px; height: 58px;" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="cloud-bank" style="left: 0px; top: 252px;" picking-mode="Ignore">
                <ui:VisualElement class="cloud cloud--front cloud--bump" style="left: -34px; top: 30px; width: 112px; height: 112px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--front cloud--bump" style="left: 56px; top: 8px; width: 122px; height: 122px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--front cloud--bump" style="left: 164px; top: 40px; width: 100px; height: 100px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--front cloud--bump" style="left: 246px; top: 18px; width: 130px; height: 130px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--front cloud--bump" style="left: 368px; top: 34px; width: 110px; height: 110px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--front cloud--bump" style="left: 456px; top: 4px; width: 140px; height: 140px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--front cloud--bump" style="left: 566px; top: 28px; width: 112px; height: 112px;" picking-mode="Ignore" />
                <ui:VisualElement class="cloud cloud--front cloud--base" style="left: -30px; top: 72px; width: 720px; height: 60px;" picking-mode="Ignore" />
            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="title-screen" class="screen title-screen">
            <ui:Label class="logo" text="Moonbrew" picking-mode="Ignore" />
            <ui:Label name="prompt" class="prompt" text="Click or press any key" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="main-screen" class="screen main-screen">
            <ui:Label class="logo logo--small" text="Moonbrew" picking-mode="Ignore" />
            <ui:VisualElement class="menu-items">
                <ui:Button name="continue" class="menu-item" text="Continue" />
                <ui:Button name="new-game" class="menu-item" text="New Game" />
                <ui:Button name="load" class="menu-item" text="Load Game" />
                <ui:Button name="settings" class="menu-item" text="Settings" />
                <ui:Button name="quit" class="menu-item" text="Quit" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="load-screen" class="screen panel-screen">
            <ui:VisualElement class="panel">
                <ui:Label class="panel__title" text="Load Game" picking-mode="Ignore" />
                <ui:ScrollView name="games" class="games" />
                <ui:Label name="no-games" class="games__empty" text="No saved game yet." picking-mode="Ignore" />
                <ui:Button name="load-back" class="menu-item menu-item--back" text="Back" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="settings-screen" class="screen panel-screen">
            <ui:VisualElement class="panel">
                <ui:Label class="panel__title" text="Settings" picking-mode="Ignore" />
                <ui:VisualElement class="setting">
                    <ui:Label class="setting__name" text="Fullscreen" picking-mode="Ignore" />
                    <ui:Button name="fullscreen" class="setting__value" />
                </ui:VisualElement>
                <ui:VisualElement class="setting">
                    <ui:Label class="setting__name" text="Resolution" picking-mode="Ignore" />
                    <ui:VisualElement class="setting__choice">
                        <ui:Button name="resolution-previous" class="setting__arrow" text="&lt;" />
                        <ui:Label name="resolution" class="setting__current" picking-mode="Ignore" />
                        <ui:Button name="resolution-next" class="setting__arrow" text="&gt;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="setting">
                    <ui:Label class="setting__name" text="Pixel rendering" picking-mode="Ignore" />
                    <ui:Button name="pixel-mode" class="setting__value" />
                </ui:VisualElement>
                <ui:Button name="settings-back" class="menu-item menu-item--back" text="Back" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
