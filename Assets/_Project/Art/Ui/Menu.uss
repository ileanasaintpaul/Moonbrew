/* Title screen and main menu, after the Fantasy Menus title and main menu screens, recoloured in Moonbrew's violet.
   No castle or dragon: a night sky with the moon. Laid out for the 640x360 interface. */

.title-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Night sky */
.sky {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(24, 18, 44);
}

/* Three bands lighter towards the ground: a stepped gradient, in keeping with the pixel look. */
.horizon {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    background-color: rgba(70, 48, 116, 0.18);
}

.horizon--middle {
    height: 28%;
}

.horizon--low {
    height: 14%;
}

.stars {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.star {
    position: absolute;
    width: 1px;
    height: 1px;
    background-color: rgb(238, 232, 255);
    transition-property: opacity;
    transition-duration: 0.9s;
}

.star--big {
    width: 2px;
    height: 2px;
}

.star--dim {
    opacity: 0.25;
}

.moon-glow {
    position: absolute;
    right: 64px;
    top: 26px;
    width: 128px;
    height: 128px;
    border-radius: 64px;
    background-color: rgba(196, 176, 255, 0.08);
}

.moon {
    position: absolute;
    right: 96px;
    top: 58px;
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(236, 228, 255);
}

.moon__crater {
    position: absolute;
    background-color: rgba(196, 182, 236, 0.55);
}

.moon__crater--large {
    left: 12px;
    top: 16px;
    width: 18px;
    height: 18px;
    border-radius: 9px;
}

.moon__crater--medium {
    left: 38px;
    top: 34px;
    width: 12px;
    height: 12px;
    border-radius: 6px;
}

.moon__crater--small {
    left: 30px;
    top: 10px;
    width: 7px;
    height: 7px;
    border-radius: 4px;
}

/* Screens: one shown at a time */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.screen--shown {
    display: flex;
}

.logo {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 46px;
    color: rgb(240, 234, 255);
    letter-spacing: 1px;
}

.title-screen {
    align-items: center;
    justify-content: center;
}

.prompt {
    margin-top: 44px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 12px;
    color: rgb(196, 182, 236);
}

/* Main menu: the logo and a column of items on the left, as in the pack's main menu */
.main-screen {
    padding: 36px 0 0 46px;
    align-items: flex-start;
}

.logo--small {
    font-size: 30px;
    margin-bottom: 24px;
}

.menu-items {
    flex-direction: column;
    align-items: flex-start;
}

.menu-item {
    margin: 2px 0;
    padding: 2px 10px;
    min-width: 120px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 14px;
    color: rgb(217, 207, 245);
    -unity-text-align: middle-left;
}

.menu-item:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(150, 128, 220, 0.24);
}

.menu-item:focus {
    border-width: 0;
}

.menu-item:disabled {
    color: rgba(217, 207, 245, 0.35);
}

.menu-item--back {
    align-self: center;
    min-width: 0;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

/* Load and settings: a framed panel in the middle, the pack's window frame in violet */
.panel-screen {
    align-items: center;
    justify-content: center;
}

.panel {
    width: 360px;
    padding: 22px 28px 18px 28px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_02_Mask.png?fileID=21300000&guid=b1931ea2b245e394c899f391992d6261&type=3#SPR_FantasyMenus_Frame_Box_Large_02_Mask");
    -unity-background-image-tint-color: rgba(40, 30, 70, 0.92);
    -unity-slice-scale: 0.1px;
}

.panel__title {
    margin: 0 0 10px 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 18px;
    color: rgb(240, 234, 255);
    -unity-text-align: middle-center;
}

.games {
    max-height: 180px;
}

.game-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 3px 0;
    padding: 6px 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_01.png?fileID=21300000&guid=d984fb957cead654fb33560866a417c5&type=3#SPR_FantasyScreens_Box_Rounded_Medium_01");
    -unity-background-image-tint-color: rgba(70, 62, 94, 0.85);
    -unity-slice-scale: 0.05px;
}

.game-row:hover {
    -unity-background-image-tint-color: rgba(112, 98, 152, 0.95);
}

.game-row__day {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 13px;
    color: rgb(255, 255, 255);
}

.game-row__date,
.games__empty,
.setting__name,
.setting__current {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 12px;
    color: rgb(196, 182, 236);
}

.games__empty {
    -unity-text-align: middle-center;
    margin: 12px 0;
}

.setting {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 5px 0;
}

.setting__name {
    font-size: 13px;
    color: rgb(217, 207, 245);
}

.setting__choice {
    flex-direction: row;
    align-items: center;
}

.setting__current {
    min-width: 86px;
    -unity-text-align: middle-center;
}

.setting__value,
.setting__arrow {
    margin: 0;
    padding: 2px 8px;
    min-width: 56px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_01.png?fileID=21300000&guid=d984fb957cead654fb33560866a417c5&type=3#SPR_FantasyScreens_Box_Rounded_Medium_01");
    -unity-background-image-tint-color: rgba(70, 62, 94, 0.85);
    -unity-slice-scale: 0.04px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.setting__arrow {
    min-width: 0;
    width: 20px;
    padding: 2px 0;
}

.setting__value:hover,
.setting__arrow:hover {
    -unity-background-image-tint-color: rgba(112, 98, 152, 0.95);
}
