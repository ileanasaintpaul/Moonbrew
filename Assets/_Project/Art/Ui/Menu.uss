/* Title screen and main menu, after the Fantasy Menus title and main menu screens, recoloured in Moonbrew's violet.
   No castle or dragon: a night sky with the moon. Laid out for the 640x360 interface. */

.title-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Night sky in a lighter violet, after a pixel-art moonlit sky */
.sky {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(50, 42, 118);
}

.sky-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.stars {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.star {
    position: absolute;
    width: 1px;
    height: 1px;
    background-color: rgb(212, 202, 255);
    transition-property: opacity;
    transition-duration: 0.9s;
}

.star--big {
    width: 2px;
    height: 2px;
    background-color: rgb(178, 162, 255);
}

.star--dim {
    opacity: 0.25;
}

/* Rings of light round the moon, a little lighter than the sky */
.halo {
    position: absolute;
}

.halo--outer {
    left: 212px;
    top: -23px;
    width: 216px;
    height: 216px;
    border-radius: 108px;
    background-color: rgb(58, 50, 134);
}

.halo--inner {
    left: 238px;
    top: 3px;
    width: 164px;
    height: 164px;
    border-radius: 82px;
    background-color: rgb(66, 58, 150);
}

/* The moon and the clouds are pixel art drawn at twice their texture size (the front bank at three times),
   so every art pixel stays a whole number of screen pixels. */
.moon {
    position: absolute;
    left: 261px;
    top: 26px;
    width: 118px;
    height: 118px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Pixabay/T_Ui_Moon.png?fileID=2800000&guid=ddcd60a5ba3c736489137edffbe8c8dc&type=3#T_Ui_Moon");
    -unity-background-image-tint-color: rgb(236, 232, 255);
}

.cloud {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}

.cloud--wide {
    width: 152px;
    height: 64px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Pixabay/T_Ui_CloudWide.png?fileID=2800000&guid=c7fc408f13417f4428ee27601d83d186&type=3#T_Ui_CloudWide");
}

.cloud--slope {
    width: 112px;
    height: 58px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Pixabay/T_Ui_CloudSlope.png?fileID=2800000&guid=d8283c76d2b4f91448ac667e7f79518e&type=3#T_Ui_CloudSlope");
}

.cloud--flipped {
    scale: -1 1;
}

/* Further clouds are darker. */
.cloud--far {
    -unity-background-image-tint-color: rgb(124, 116, 186);
}

.cloud--back {
    -unity-background-image-tint-color: rgb(176, 170, 222);
}

.cloud--bank-back {
    -unity-background-image-tint-color: rgb(196, 190, 236);
}

/* Sunk below the screen edge so every cloud of the bank reaches the bottom. */
.cloud-bank {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -22px;
    height: 118px;
}

.cloud-bank .cloud--wide {
    width: 228px;
    height: 96px;
}

.cloud-bank .cloud--slope {
    width: 168px;
    height: 87px;
}

/* Screens: one shown at a time */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.screen--shown {
    display: flex;
}

.logo {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 46px;
    color: rgb(240, 234, 255);
    letter-spacing: 1px;
}

/* The logo sits under the moon. */
.title-screen {
    align-items: center;
    padding-top: 176px;
}

/* Dark with a light outline (the logo's white), readable on the clouds and on the sky between them. */
.prompt {
    margin-top: 44px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 12px;
    color: rgb(48, 36, 112);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(240, 234, 255);
}

/* Main menu: the logo and a column of items on the left, as in the pack's main menu */
.main-screen {
    padding: 36px 0 0 46px;
    align-items: flex-start;
}

/* Behind the logo and the items: dark violet on the left, fading into the sky (T_Ui_FadeRight, tinted). */
.menu-fade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 62%;
    background-image: url("T_Ui_FadeRight.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(5, 2, 14);
}

.logo--small {
    font-size: 30px;
    margin-bottom: 24px;
}

.menu-items {
    flex-direction: column;
    align-items: flex-start;
}

.menu-item {
    margin: 2px 0;
    padding: 2px 12px 2px 18px;
    min-width: 180px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 14px;
    color: rgb(217, 207, 245);
    -unity-text-align: middle-left;
}

.menu-item:hover {
    color: rgb(255, 255, 255);
}

/* The item under the mouse, as the pack's second menu item: a violet gradient fading to the right, between two gold lines */
.menu-item__glow {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Gradient_Horizontal_01.png?fileID=21300000&guid=9edad2581bd89dd4582a5166c20a2d9a&type=3#SPR_FantasyMenus_Gradient_Horizontal_01");
    -unity-background-image-tint-color: rgba(112, 72, 232, 0.55);
}

.menu-item:hover .menu-item__glow {
    display: flex;
}

.menu-item:disabled .menu-item__glow {
    display: none;
}

.menu-item__line {
    position: absolute;
    left: 0;
    right: 0;
    height: 8px;
    -unity-slice-scale: 0.08px;
}

.menu-item__line--top {
    top: -2px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Item_09_Top.png?fileID=21300000&guid=b7b9532c9529f08449ee7f93a713cad5&type=3#SPR_FantasyMenus_Menu_Item_09_Top");
}

.menu-item__line--bottom {
    bottom: -2px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Item_09_Bottom.png?fileID=21300000&guid=e226d00b32b37414b9b0c82dfa5f58b4&type=3#SPR_FantasyMenus_Menu_Item_09_Bottom");
}

/* The text is a label after the glow, so the glow stays behind it: a button with children no longer measures its own text. */
.menu-item__label {
    margin: 0;
    padding: 0;
    color: rgb(217, 207, 245);
}

.menu-item:hover > .menu-item__label {
    color: rgb(255, 255, 255);
}

.menu-item:disabled > .menu-item__label {
    color: rgba(217, 207, 245, 0.35);
}

.menu-item:focus {
    border-width: 0;
}

.menu-item:disabled {
    color: rgba(217, 207, 245, 0.35);
}

.menu-item--back {
    align-self: center;
    min-width: 0;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

/* Load and settings: a framed panel in the middle, the pack's window frame in violet */
.panel-screen {
    align-items: center;
    justify-content: center;
}

.panel {
    width: 360px;
    padding: 22px 28px 18px 28px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_02_Mask.png?fileID=21300000&guid=b1931ea2b245e394c899f391992d6261&type=3#SPR_FantasyMenus_Frame_Box_Large_02_Mask");
    -unity-background-image-tint-color: rgba(40, 30, 70, 0.92);
    -unity-slice-scale: 0.1px;
}

.panel__title {
    margin: 0 0 10px 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 18px;
    color: rgb(240, 234, 255);
    -unity-text-align: middle-center;
}

.games {
    max-height: 180px;
}

.game-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 3px 0;
    padding: 6px 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_01.png?fileID=21300000&guid=d984fb957cead654fb33560866a417c5&type=3#SPR_FantasyScreens_Box_Rounded_Medium_01");
    -unity-background-image-tint-color: rgba(70, 62, 94, 0.85);
    -unity-slice-scale: 0.05px;
}

.game-row:hover {
    -unity-background-image-tint-color: rgba(112, 98, 152, 0.95);
}

.game-row__day {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 13px;
    color: rgb(255, 255, 255);
}

.game-row__date,
.games__empty,
.setting__name,
.setting__current {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 12px;
    color: rgb(196, 182, 236);
}

.games__empty {
    -unity-text-align: middle-center;
    margin: 12px 0;
}

.setting {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 5px 0;
}

.setting__name {
    font-size: 13px;
    color: rgb(217, 207, 245);
}

.setting__choice {
    flex-direction: row;
    align-items: center;
}

.setting__current {
    min-width: 86px;
    -unity-text-align: middle-center;
}

.setting__value,
.setting__arrow {
    margin: 0;
    padding: 2px 8px;
    min-width: 56px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_01.png?fileID=21300000&guid=d984fb957cead654fb33560866a417c5&type=3#SPR_FantasyScreens_Box_Rounded_Medium_01");
    -unity-background-image-tint-color: rgba(70, 62, 94, 0.85);
    -unity-slice-scale: 0.04px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.setting__arrow {
    min-width: 0;
    width: 20px;
    padding: 2px 0;
}

.setting__value:hover,
.setting__arrow:hover {
    -unity-background-image-tint-color: rgba(112, 98, 152, 0.95);
}

/* Pause menu: dark violet on the left, fading into the game behind it */
.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.pause__panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 60%;
    padding: 46px 0 0 34px;
    background-image: url("T_Ui_FadeRight.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(5, 2, 14, 0.94);
}

.pause__title {
    margin: 0 0 18px 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 24px;
    color: rgb(240, 234, 255);
}

.pause__hint {
    position: absolute;
    left: 34px;
    right: 14px;
    bottom: 22px;
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 10px;
    color: rgba(196, 182, 236, 0.8);
}
