/* Title screen and main menu, after the Fantasy Menus title and main menu screens, recoloured in Moonbrew's violet.
   No castle or dragon: a night sky with the moon. Laid out for the 640x360 interface. */

.title-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Night sky, after a pixel-art moonlit sky in blue violet */
.sky {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(38, 34, 92);
}

.stars,
.clouds {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.star {
    position: absolute;
    width: 1px;
    height: 1px;
    background-color: rgb(206, 206, 255);
    transition-property: opacity;
    transition-duration: 0.9s;
}

.star--big {
    width: 2px;
    height: 2px;
    background-color: rgb(150, 140, 245);
}

.star--dim {
    opacity: 0.25;
}

/* Rings of light round the moon, a little lighter than the sky */
.halo {
    position: absolute;
}

.halo--outer {
    left: 236px;
    top: 26px;
    width: 168px;
    height: 168px;
    border-radius: 84px;
    background-color: rgb(46, 42, 108);
}

.halo--inner {
    left: 260px;
    top: 50px;
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: rgb(54, 50, 124);
}

.moon {
    position: absolute;
    left: 286px;
    top: 76px;
    width: 68px;
    height: 68px;
    border-radius: 34px;
    background-color: rgb(228, 226, 250);
}

.moon__spot {
    position: absolute;
    background-color: rgb(196, 194, 228);
}

.moon__spot--large {
    left: 34px;
    top: 18px;
    width: 22px;
    height: 20px;
    border-radius: 10px;
}

.moon__spot--medium {
    left: 14px;
    top: 34px;
    width: 14px;
    height: 12px;
    border-radius: 6px;
}

.moon__spot--small {
    left: 22px;
    top: 12px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
}

/* Clouds: banks of round bumps, each with a light rim on top, on a long base with a darker belly */
.cloud-bank {
    position: absolute;
}

.cloud {
    position: absolute;
    border-top-width: 3px;
}

.cloud--bump {
    border-radius: 50%;
}

.cloud--base {
    border-radius: 26px;
    border-top-width: 0;
    border-bottom-width: 4px;
}

.cloud--back {
    background-color: rgb(68, 64, 146);
    border-top-color: rgb(104, 102, 196);
    border-bottom-color: rgb(56, 52, 126);
}

.cloud--front {
    background-color: rgb(86, 84, 172);
    border-top-color: rgb(124, 124, 214);
    border-bottom-color: rgb(72, 70, 150);
}

/* Screens: one shown at a time */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.screen--shown {
    display: flex;
}

.logo {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 46px;
    color: rgb(240, 234, 255);
    letter-spacing: 1px;
}

/* The logo sits under the moon. */
.title-screen {
    align-items: center;
    padding-top: 176px;
}

.prompt {
    margin-top: 44px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 12px;
    color: rgb(196, 182, 236);
}

/* Main menu: the logo and a column of items on the left, as in the pack's main menu */
.main-screen {
    padding: 36px 0 0 46px;
    align-items: flex-start;
}

.logo--small {
    font-size: 30px;
    margin-bottom: 24px;
}

.menu-items {
    flex-direction: column;
    align-items: flex-start;
}

.menu-item {
    margin: 2px 0;
    padding: 2px 10px;
    min-width: 120px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 14px;
    color: rgb(217, 207, 245);
    -unity-text-align: middle-left;
}

.menu-item:hover {
    color: rgb(255, 255, 255);
    background-color: rgba(150, 128, 220, 0.24);
}

.menu-item:focus {
    border-width: 0;
}

.menu-item:disabled {
    color: rgba(217, 207, 245, 0.35);
}

.menu-item--back {
    align-self: center;
    min-width: 0;
    margin-top: 10px;
    -unity-text-align: middle-center;
}

/* Load and settings: a framed panel in the middle, the pack's window frame in violet */
.panel-screen {
    align-items: center;
    justify-content: center;
}

.panel {
    width: 360px;
    padding: 22px 28px 18px 28px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_02_Mask.png?fileID=21300000&guid=b1931ea2b245e394c899f391992d6261&type=3#SPR_FantasyMenus_Frame_Box_Large_02_Mask");
    -unity-background-image-tint-color: rgba(40, 30, 70, 0.92);
    -unity-slice-scale: 0.1px;
}

.panel__title {
    margin: 0 0 10px 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 18px;
    color: rgb(240, 234, 255);
    -unity-text-align: middle-center;
}

.games {
    max-height: 180px;
}

.game-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 3px 0;
    padding: 6px 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_01.png?fileID=21300000&guid=d984fb957cead654fb33560866a417c5&type=3#SPR_FantasyScreens_Box_Rounded_Medium_01");
    -unity-background-image-tint-color: rgba(70, 62, 94, 0.85);
    -unity-slice-scale: 0.05px;
}

.game-row:hover {
    -unity-background-image-tint-color: rgba(112, 98, 152, 0.95);
}

.game-row__day {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 13px;
    color: rgb(255, 255, 255);
}

.game-row__date,
.games__empty,
.setting__name,
.setting__current {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 12px;
    color: rgb(196, 182, 236);
}

.games__empty {
    -unity-text-align: middle-center;
    margin: 12px 0;
}

.setting {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 5px 0;
}

.setting__name {
    font-size: 13px;
    color: rgb(217, 207, 245);
}

.setting__choice {
    flex-direction: row;
    align-items: center;
}

.setting__current {
    min-width: 86px;
    -unity-text-align: middle-center;
}

.setting__value,
.setting__arrow {
    margin: 0;
    padding: 2px 8px;
    min-width: 56px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_01.png?fileID=21300000&guid=d984fb957cead654fb33560866a417c5&type=3#SPR_FantasyScreens_Box_Rounded_Medium_01");
    -unity-background-image-tint-color: rgba(70, 62, 94, 0.85);
    -unity-slice-scale: 0.04px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 12px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.setting__arrow {
    min-width: 0;
    width: 20px;
    padding: 2px 0;
}

.setting__value:hover,
.setting__arrow:hover {
    -unity-background-image-tint-color: rgba(112, 98, 152, 0.95);
}

/* Pause menu: a see-through violet strip on the left, the game still visible behind it */
.pause {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(12, 8, 24, 0.25);
}

.pause__panel {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 190px;
    padding: 46px 0 0 34px;
    background-color: rgba(30, 22, 54, 0.82);
    border-right-width: 1px;
    border-right-color: rgba(150, 128, 220, 0.4);
}

.pause__title {
    margin: 0 0 18px 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 24px;
    color: rgb(240, 234, 255);
}

.pause__hint {
    position: absolute;
    left: 34px;
    right: 14px;
    bottom: 22px;
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 10px;
    color: rgba(196, 182, 236, 0.8);
}
