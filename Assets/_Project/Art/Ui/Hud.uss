.clock-hud {
    position: absolute;
    top: 8px;
    left: 10px;
    padding: 2px 6px;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(243, 230, 196);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(43, 34, 51);
    background-color: rgba(43, 34, 51, 0.45);
    border-radius: 3px;
}

/* Placeholder hotbar: the Fantasy HUD pack sprites will replace these colors and borders. */
.hotbar {
    position: absolute;
    bottom: 6px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.hotbar-slot {
    width: 28px;
    height: 28px;
    margin: 0 1px;
    background-color: rgba(43, 34, 51, 0.7);
    border-width: 1px;
    border-color: rgb(120, 98, 84);
    border-radius: 3px;
}

.hotbar-slot--selected {
    border-color: rgb(243, 214, 120);
    background-color: rgba(84, 64, 72, 0.85);
}

.hotbar-slot__icon {
    position: absolute;
    top: 3px;
    left: 3px;
    right: 3px;
    bottom: 3px;
    -unity-background-scale-mode: scale-to-fit;
}

.hotbar-slot__count,
.hotbar-slot__key {
    position: absolute;
    padding: 0;
    margin: 0;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(243, 230, 196);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(43, 34, 51);
}

.hotbar-slot__count {
    right: 1px;
    bottom: 0;
}

.hotbar-slot__key {
    left: 2px;
    top: 0;
    font-size: 6px;
    color: rgb(200, 186, 160);
}

/* Water inside the watering can icon, hidden on other slots. Same box as the icon; the tank matches
   the see-through body of T_Icon_WateringCan (16 px: columns 1 to 9, rows 5 to 10). */
.hotbar-slot__water {
    position: absolute;
    top: 3px;
    left: 3px;
    right: 3px;
    bottom: 3px;
    display: none;
}

.hotbar-slot__water-tank {
    position: absolute;
    left: 6.25%;
    width: 56.25%;
    bottom: 31.25%;
    height: 37.5%;
    background-color: rgb(43, 34, 51);
}

.hotbar-slot__water-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background-color: rgb(93, 160, 214);
}

/* Game menu with tabs (only Recipes for now), placeholder look like the dialogs. */
.menu {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(23, 18, 31, 0.6);
}

.menu__window {
    width: 70%;
    max-width: 560px;
    height: 75%;
    padding: 8px 10px;
    background-color: rgb(43, 34, 51);
    border-width: 2px;
    border-color: rgb(120, 98, 84);
    border-radius: 4px;
}

.menu__header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.menu__tabs {
    flex-direction: row;
}

.menu__tab {
    margin: 0 4px 0 0;
    padding: 2px 10px;
    font-size: 12px;
    color: rgb(200, 186, 160);
    background-color: rgb(58, 46, 60);
    border-width: 1px;
    border-color: rgb(120, 98, 84);
    border-radius: 3px;
}

.menu__tab--active {
    color: rgb(243, 214, 120);
    border-color: rgb(243, 214, 120);
}

.menu__close {
    padding: 0 8px;
    font-size: 14px;
    color: rgb(243, 230, 196);
    background-color: rgb(84, 64, 72);
    border-width: 1px;
    border-color: rgb(120, 98, 84);
    border-radius: 3px;
}

.menu__hint {
    font-size: 10px;
    color: rgb(200, 186, 160);
    margin-bottom: 4px;
}

.menu__content {
    flex-grow: 1;
}

/* Thin scrollbar in the menu colors instead of Unity's default white one. */
.menu__content .unity-scroller--vertical {
    width: 6px;
    border-width: 0;
}

.menu__content .unity-scroller__low-button,
.menu__content .unity-scroller__high-button {
    display: none;
}

.menu__content .unity-base-slider__tracker {
    background-color: rgb(58, 46, 60);
    border-width: 0;
}

.menu__content .unity-base-slider__dragger {
    background-color: rgb(120, 98, 84);
    border-width: 0;
    border-radius: 3px;
}

.menu__content .unity-scroller--vertical .unity-base-slider__drag-container,
.menu__content .unity-scroller--vertical .unity-base-slider__tracker {
    margin: 0;
}

.recipe {
    flex-direction: row;
    align-items: center;
    padding: 4px;
    margin-bottom: 4px;
    background-color: rgb(58, 46, 60);
    border-radius: 3px;
}

.recipe--locked {
    opacity: 0.5;
}

.recipe__icon {
    width: 32px;
    height: 32px;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.recipe__body {
    flex-grow: 1;
}

.recipe__body > Label {
    margin: 0;
    padding: 0;
}

.recipe__title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(243, 230, 196);
}

.recipe__ingredients {
    font-size: 10px;
    color: rgb(243, 230, 196);
}

.recipe__status {
    font-size: 10px;
    color: rgb(214, 160, 120);
}

.recipe__cook {
    padding: 2px 10px;
    font-size: 11px;
    color: rgb(243, 230, 196);
    background-color: rgb(84, 64, 72);
    border-width: 1px;
    border-color: rgb(120, 98, 84);
    border-radius: 3px;
}

.recipe__cook:disabled {
    opacity: 0.4;
}

/* Placeholder dialogs (sleep prompt, day recap), to be reskinned with the Fantasy HUD pack. */
.modal {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(23, 18, 31, 0.55);
}

.modal__box {
    min-width: 220px;
    max-width: 360px;
    padding: 10px 14px;
    background-color: rgb(43, 34, 51);
    border-width: 2px;
    border-color: rgb(120, 98, 84);
    border-radius: 4px;
}

.modal__title {
    margin-bottom: 6px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(243, 214, 120);
}

.modal__text {
    margin-bottom: 8px;
    font-size: 11px;
    white-space: normal;
    color: rgb(243, 230, 196);
}

.modal__buttons {
    flex-direction: row;
    justify-content: center;
}

.modal__button {
    margin: 0 4px;
    padding: 2px 10px;
    font-size: 11px;
    color: rgb(243, 230, 196);
    background-color: rgb(84, 64, 72);
    border-width: 1px;
    border-color: rgb(120, 98, 84);
    border-radius: 3px;
}

.modal__button:hover {
    border-color: rgb(243, 214, 120);
}
