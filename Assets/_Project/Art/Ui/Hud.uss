/* HUD and windows drawn with the Interface Fantasy sprites, fonts and tints (package com.moonbrew.synty),
   after the Fantasy Screens prefabs: GameTime_01 (time), HUD_HotBar_01 (hotbar), Unit_Info_01 (windows).
   The sprites are large: -unity-slice-scale brings their nine-slice borders down to the 640x360 HUD. */

/* Time, top right: a see-through rounded box, hourglass and time, then the phase and the day. */
.clock-hud {
    position: absolute;
    top: 6px;
    right: 8px;
    padding: 4px 10px 5px 8px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_02.png?fileID=21300000&guid=a69a7bdf9916055469390b2e328d1672&type=3#SPR_FantasyScreens_Box_Rounded_Medium_02");
    -unity-background-image-tint-color: rgba(34, 30, 48, 0.55);
    -unity-slice-scale: 0.1px;
}

.clock-hud__row {
    flex-direction: row;
    align-items: center;
}

.clock-hud__icon {
    width: 14px;
    height: 16px;
    margin-right: 3px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyWarriorHUD/Sprites/Icons_Status/ICON_FantasyWarrior_Status_Time_01_Underlay.png?fileID=21300000&guid=04d45951f9eddd0428b6e54b779a06cf&type=3#ICON_FantasyWarrior_Status_Time_01_Underlay");
    -unity-background-scale-mode: scale-to-fit;
}

.clock-hud__time,
.clock-hud__phase,
.clock-hud__day {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(23, 18, 31, 0.8);
}

.clock-hud__time {
    font-size: 17px;
}

.clock-hud__phase,
.clock-hud__day {
    font-size: 10px;
}

.clock-hud__phase {
    margin-right: 5px;
    color: rgb(196, 182, 236);
}

/* Hotbar: one see-through rounded bar holding rounded brown slots with a large diamond tracery;
   the key number sits in a dark box under each slot, overlapping the bar's lower edge. */
.hotbar {
    position: absolute;
    bottom: 3px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    padding: 3px 4px 14px 4px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Bar_Rounded_01.png?fileID=21300000&guid=116c10aff40b2244c9f593139c641347&type=3#SPR_FantasyScreens_Bar_Rounded_01");
    -unity-background-image-tint-color: rgba(34, 30, 48, 0.55);
    -unity-slice-scale: 0.1px;
}

.hotbar-slot {
    width: 24px;
    height: 24px;
    margin: 0 2px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_01.png?fileID=21300000&guid=d984fb957cead654fb33560866a417c5&type=3#SPR_FantasyScreens_Box_Rounded_Medium_01");
    -unity-background-image-tint-color: rgba(70, 62, 94, 0.85);
    -unity-slice-scale: 0.05px;
}

.hotbar-slot--selected {
    -unity-background-image-tint-color: rgba(138, 124, 182, 0.95);
}

.hotbar-slot__runes {
    position: absolute;
    top: 1px;
    left: 1px;
    right: 1px;
    bottom: 1px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyWarriorHUD/Sprites/HUD/SPR_HUD_FantasyWarrior_Tracery_Diamond_01.png?fileID=21300000&guid=58f328f399575b24da3ebc78b0a49dd5&type=3#SPR_HUD_FantasyWarrior_Tracery_Diamond_01");
    -unity-background-image-tint-color: rgba(28, 24, 40, 0.7);
    -unity-background-scale-mode: scale-to-fit;
}

.hotbar-slot--selected .hotbar-slot__runes {
    -unity-background-image-tint-color: rgba(72, 62, 104, 0.7);
}

.hotbar-slot__icon {
    position: absolute;
    top: 2px;
    left: 2px;
    right: 2px;
    bottom: 2px;
    -unity-background-scale-mode: scale-to-fit;
}

/* Quantity like the pack's Label_Item_Amount: LT Museum Bold in white, with a thin outline
   so it reads over any icon. */
.hotbar-slot__count {
    position: absolute;
    margin: 0;
    padding: 0;
    right: 2px;
    top: -2px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 9px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(20, 16, 30, 0.7);
}

/* Key number like the pack's Input_Hotkey, in the same rounded box, lighter than the floor behind it;
   LT Museum rather than the pack's Grenze, whose old-style digits do not sit on one line. */
.hotbar-slot__key {
    position: absolute;
    margin: 0;
    padding: 0 0 2px 0;
    left: 4px;
    right: 4px;
    bottom: -12px;
    height: 11px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 10px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyScreens/Sprites/General/SPR_FantasyScreens_Box_Rounded_Medium_02.png?fileID=21300000&guid=a69a7bdf9916055469390b2e328d1672&type=3#SPR_FantasyScreens_Box_Rounded_Medium_02");
    -unity-background-image-tint-color: rgb(170, 154, 214);
    -unity-slice-scale: 0.02px;
}

/* Water inside the watering can icon, hidden on other slots. Same box as the icon; the tank matches
   the see-through body of T_Icon_WateringCan (16 px: columns 1 to 9, rows 5 to 10). */
.hotbar-slot__water {
    position: absolute;
    top: 2px;
    left: 2px;
    right: 2px;
    bottom: 2px;
    display: none;
}

.hotbar-slot__water-tank {
    position: absolute;
    left: 6.25%;
    width: 56.25%;
    bottom: 31.25%;
    height: 37.5%;
    background-color: rgb(43, 34, 51);
}

.hotbar-slot__water-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100%;
    background-color: rgb(93, 160, 214);
}

/* Windows (game menu, day recap, sleep prompt): a see-through dark red box, a red lip and a frame with
   gold corners, a large white title, a dark band under it, red banners for tabs and buttons. */
.window {
    padding: 26px 30px 24px 30px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_02_Mask.png?fileID=21300000&guid=b1931ea2b245e394c899f391992d6261&type=3#SPR_FantasyMenus_Frame_Box_Large_02_Mask");
    -unity-background-image-tint-color: rgba(53, 24, 24, 0.85);
    -unity-slice-scale: 0.1px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
}

.window__lip,
.window__frame {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-slice-scale: 0.1px;
}

.window__lip {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_02_Lip.png?fileID=21300000&guid=e685c9fea32391740a81b2cd579878b5&type=3#SPR_FantasyMenus_Frame_Box_Large_02_Lip");
    -unity-background-image-tint-color: rgb(114, 39, 0);
}

.window__frame {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_02.png?fileID=21300000&guid=b71ee1d7918485a47b2be8561d9f6bb0&type=3#SPR_FantasyMenus_Frame_Box_Large_02");
}

.window__title {
    margin: 0 0 4px 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(23, 18, 31, 0.8);
}

.window__band {
    margin: 0 0 6px 0;
    padding: 3px 10px;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 10px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(255, 255, 255);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Box_Small_Parchment_03.png?fileID=21300000&guid=64d4736c8b159b74695478fa959043d2&type=3#SPR_FantasyMenus_Box_Small_Parchment_03");
    -unity-background-image-tint-color: rgb(29, 11, 4);
    -unity-slice-scale: 0.12px;
}

/* Red banner with a gold frame: the section header of the pack, used for tabs and buttons. */
.banner {
    height: 20px;
    margin: 0 3px;
    padding: 0 26px;
    min-width: 100px;
    flex-shrink: 0;
    white-space: nowrap;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 10px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Background.png?fileID=21300000&guid=14dc3860d501b70489527d3f3358cec8&type=3#SPR_FantasyMenus_Menu_Button_03_Background");
    -unity-background-image-tint-color: rgb(84, 22, 4);
    -unity-slice-scale: 0.078px;
    border-width: 0;
    border-radius: 0;
}

.banner__frame {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_03_Frame.png?fileID=21300000&guid=9edb3fd596a99454e80f70bfecfa5769&type=3#SPR_FantasyMenus_Menu_Button_03_Frame");
    -unity-slice-scale: 0.078px;
}

.banner:hover {
    -unity-background-image-tint-color: rgb(120, 34, 8);
}

.banner:disabled {
    opacity: 0.45;
}

/* Game menu with tabs (only Recipes for now). */
.menu {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(23, 18, 31, 0.45);
}

.menu__window {
    width: 66%;
    max-width: 480px;
    height: 86%;
}

.menu__tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 6px;
}

.menu__tab {
    min-width: 120px;
}

.menu__close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 16px;
    height: 16px;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 11px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Box_Small_Parchment_03.png?fileID=21300000&guid=64d4736c8b159b74695478fa959043d2&type=3#SPR_FantasyMenus_Box_Small_Parchment_03");
    -unity-background-image-tint-color: rgb(29, 11, 4);
    -unity-slice-scale: 0.1px;
    border-width: 0;
}

.menu__close:hover {
    -unity-background-image-tint-color: rgb(84, 22, 4);
}

.menu__content {
    flex-grow: 1;
}

/* Thin scrollbar in the window colors instead of the default white one. */
.menu__content .unity-scroller--vertical {
    width: 5px;
    border-width: 0;
}

.menu__content .unity-scroller__low-button,
.menu__content .unity-scroller__high-button {
    display: none;
}

.menu__content .unity-base-slider__tracker {
    background-color: rgba(29, 11, 4, 0.8);
    border-width: 0;
}

.menu__content .unity-base-slider__dragger {
    background-color: rgb(114, 39, 0);
    border-width: 0;
    border-radius: 2px;
}

.menu__content .unity-scroller--vertical .unity-base-slider__drag-container,
.menu__content .unity-scroller--vertical .unity-base-slider__tracker {
    margin: 0;
}

/* A recipe line, like a stat line of the pack: dark band, icon on a red diamond, then the cook banner. */
.recipe {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px 3px 3px;
    margin-bottom: 3px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Box_Small_Parchment_02.png?fileID=21300000&guid=0aa7978b6eb231a4491db61d3d132c5c&type=3#SPR_FantasyMenus_Box_Small_Parchment_02");
    -unity-background-image-tint-color: rgba(10, 3, 0, 0.75);
    -unity-slice-scale: 0.12px;
}

.recipe--locked {
    opacity: 0.5;
}

.badge {
    width: 34px;
    height: 34px;
    margin-right: 6px;
}

.badge__back,
.badge__frame,
.badge__icon {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.badge__back {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Mask_Diamond_01.png?fileID=21300000&guid=ee9fc8f6cb43d8846b07c3d1de4173ce&type=3#SPR_FantasyMenus_Mask_Diamond_01");
    -unity-background-image-tint-color: rgb(135, 26, 0);
}

.badge__icon {
    top: 7px;
    left: 7px;
    right: 7px;
    bottom: 7px;
}

.badge__frame {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyWarriorHUD/Sprites/FantasyWarrior/SPR_FantasyWarrior_Frame_Diamond_01.png?fileID=21300000&guid=86df176308a508d4583ecfde3d4f81b1&type=3#SPR_FantasyWarrior_Frame_Diamond_01");
    -unity-background-image-tint-color: rgb(178, 166, 159);
}

.recipe__body {
    flex-grow: 1;
}

.recipe__body > Label {
    margin: 0;
    padding: 0;
}

.recipe__title {
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/LT%20Museum/LTMuseum-Bold.ttf?fileID=12800000&guid=f227da7e80831044f8ab86e745f48a12&type=3#LTMuseum-Bold");
    font-size: 12px;
    color: rgb(255, 255, 255);
}

.recipe__ingredients {
    font-size: 10px;
    color: rgb(236, 214, 170);
}

.recipe__status {
    font-size: 10px;
    color: rgb(240, 160, 110);
}

.recipe__cook {
    margin: 0;
}

/* Dialogs (sleep prompt, day recap). */
.modal {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(23, 18, 31, 0.4);
}

.modal__box {
    min-width: 250px;
    max-width: 360px;
}

.modal__text {
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
    font-size: 11px;
    color: rgb(236, 214, 170);
    margin-bottom: 8px;
}

.modal__buttons {
    flex-direction: row;
    justify-content: center;
}

/* Measured before the pack font applies, so the banner needs room for its longest label. */
.modal__buttons .banner {
    min-width: 150px;
}

/* Covers the screen while the player walks to another scene. */
.screen-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(23, 18, 31);
    opacity: 0;
    transition-property: opacity;
}

.screen-fade--dark {
    opacity: 1;
}
