<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <Style src="Menu.uss" />
    <Style src="CharacterCreation.uss" />
    <!-- The creation panel, laid out on its own texture and drawn in perspective on a quad of the scene (WorldPanel).
         Each page's colour sits under it, in the colour section. -->
    <ui:VisualElement class="window creation-panel">
        <ui:VisualElement class="window__lip" picking-mode="Ignore" />
        <ui:VisualElement class="window__frame" picking-mode="Ignore" />
        <ui:Label name="panel-title" class="window__title creation-panel__title" picking-mode="Ignore" />

        <ui:VisualElement name="page-body" class="panel-page">
            <ui:VisualElement class="gauge-row">
                <ui:Label class="gauge-row__name" text="Body Type" picking-mode="Ignore" />
                <ui:VisualElement class="gauge-row__gauge">
                    <ui:SliderInt name="shape-type" class="gauge" />
                    <ui:VisualElement class="gauge-row__ends"><ui:Label text="Masculine" /><ui:Label text="Feminine" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="gauge-row">
                <ui:Label class="gauge-row__name" text="Body Size" picking-mode="Ignore" />
                <ui:VisualElement class="gauge-row__gauge">
                    <ui:SliderInt name="shape-size" class="gauge" />
                    <ui:VisualElement class="gauge-row__ends"><ui:Label text="Slim" /><ui:Label text="Heavy" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="gauge-row">
                <ui:Label class="gauge-row__name" text="Musculature" picking-mode="Ignore" />
                <ui:VisualElement class="gauge-row__gauge">
                    <ui:SliderInt name="shape-musculature" class="gauge" />
                    <ui:VisualElement class="gauge-row__ends"><ui:Label text="Lean" /><ui:Label text="Muscular" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="page-parts" class="panel-page">
            <ui:ScrollView class="panel-scroll" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="grid" class="grid" />
            </ui:ScrollView>
            <ui:Label name="counter" class="creation__counter" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="page-name" class="panel-page">
            <ui:Label class="section-name" text="Your Name" picking-mode="Ignore" />
            <ui:TextField name="owner-name" class="name-field" />
            <ui:Button name="start" class="menu-item start">
                <ui:VisualElement class="menu-item__glow" picking-mode="Ignore" />
                <ui:Label class="menu-item__label" text="Start" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>

        <ui:VisualElement name="colour-section" class="colour-section">
            <ui:Label name="colour-title" class="section-name" picking-mode="Ignore" />
            <ui:VisualElement name="colours" class="swatches" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
