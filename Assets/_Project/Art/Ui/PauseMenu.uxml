<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Menu.uss" />
    <ui:VisualElement name="pause-menu" class="pause">
        <ui:VisualElement class="pause__panel">
            <ui:Label class="pause__title" text="Paused" picking-mode="Ignore" />
            <ui:VisualElement class="menu-items">
                <ui:Button name="resume" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore"><ui:VisualElement class="menu-item__line menu-item__line--top" picking-mode="Ignore" /><ui:VisualElement class="menu-item__line menu-item__line--bottom" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:Label class="menu-item__label" text="Resume" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="title-screen" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore"><ui:VisualElement class="menu-item__line menu-item__line--top" picking-mode="Ignore" /><ui:VisualElement class="menu-item__line menu-item__line--bottom" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:Label class="menu-item__label" text="Title Screen" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="quit" class="menu-item">
                    <ui:VisualElement class="menu-item__glow" picking-mode="Ignore"><ui:VisualElement class="menu-item__line menu-item__line--top" picking-mode="Ignore" /><ui:VisualElement class="menu-item__line menu-item__line--bottom" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:Label class="menu-item__label" text="Quit Game" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Label class="pause__hint" text="The day is saved when you go to sleep." picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
