<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="sleep-prompt" class="modal">
        <ui:VisualElement class="modal__box">
            <ui:Label name="question" class="modal__title" text="Dormir et terminer la journée ?" />
            <ui:VisualElement class="modal__buttons">
                <ui:Button name="yes" class="modal__button" text="Dormir" />
                <ui:Button name="no" class="modal__button" text="Pas encore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
