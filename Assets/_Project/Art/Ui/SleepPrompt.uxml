<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="sleep-prompt" class="modal">
        <ui:VisualElement class="window modal__box">
            <ui:VisualElement class="window__lip" picking-mode="Ignore" />
            <ui:VisualElement class="window__frame" picking-mode="Ignore" />
            <ui:Label name="question" class="window__title" text="Sleep and end the day?" />
            <ui:VisualElement class="modal__buttons">
                <ui:Button name="yes" class="banner" text="Sleep">
                    <ui:VisualElement class="banner__frame" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="no" class="banner" text="Not yet">
                    <ui:VisualElement class="banner__frame" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
