/* Character creation, after the Fantasy Menus creation screens, in Moonbrew's violet. Two documents share this sheet:
   the icon tabs over the screen, and the panel, laid out on its own 640 by 600 texture and drawn in perspective. */

.creation {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-font-definition: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Fonts/Alegreya%20Sans/AlegreyaSans-Medium.ttf?fileID=12800000&guid=2a8b9d1289ba4894baa344c02ad05872&type=3#AlegreyaSans-Medium");
}

/* Icon tabs along the top, Q and E on each side as on the pack's screens */
.tabs {
    position: absolute;
    left: 0;
    right: 0;
    top: 8px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.tabs__key {
    margin: 0 6px;
    padding: 1px 4px;
    font-size: 10px;
    color: rgb(40, 26, 80);
    background-color: rgb(206, 190, 255);
    border-radius: 2px;
}

/* The pack's icon button: its chamfered background under its double gold frame.
   The sprite's flat side is on its right: both layers are turned a quarter so that it sits at the bottom. */
.tab {
    width: 38px;
    height: 34px;
    margin: 0 3px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.tab--selected,
.tab--selected:hover {
    scale: 1.14 1.14;
    translate: 0 -1px;
}

.tab__fill,
.tab__frame {
    position: absolute;
    left: 2px;
    top: -2px;
    width: 34px;
    height: 38px;
    rotate: 90deg;
    -unity-slice-scale: 0.12px;
}

.tab__fill {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_15_Background.png?fileID=21300000&guid=83e8c1d2709191341909c1716eb6a0c9&type=3#SPR_FantasyMenus_Menu_Button_15_Background");
    -unity-background-image-tint-color: rgb(30, 20, 72);
}

.tab:hover .tab__fill {
    -unity-background-image-tint-color: rgb(58, 38, 128);
}

.tab--selected .tab__fill,
.tab--selected:hover .tab__fill {
    -unity-background-image-tint-color: rgb(112, 72, 232);
}

.tab__frame {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Menu_Button_15_Frame.png?fileID=21300000&guid=839ea1c7478976b46bb515d4ef94bd8b&type=3#SPR_FantasyMenus_Menu_Button_15_Frame");
}

.tab__icon {
    flex-grow: 1;
    margin: 6px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(217, 207, 245);
}

.tab--selected .tab__icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.tab__icon--body { background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Moonbrew/CreationIcons/ICON_Creation_Body.png"); }
.tab__icon--face { background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Moonbrew/CreationIcons/ICON_Creation_Face.png"); }
.tab__icon--hair { background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Moonbrew/CreationIcons/ICON_Creation_Hair.png"); }
.tab__icon--beard { background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Moonbrew/CreationIcons/ICON_Creation_Beard.png"); }
.tab__icon--top { background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Moonbrew/CreationIcons/ICON_Creation_Top.png"); }
.tab__icon--bottom { background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Moonbrew/CreationIcons/ICON_Creation_Bottom.png"); }
.tab__icon--hat { background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Moonbrew/CreationIcons/ICON_Creation_Hat.png"); }
.tab__icon--name { background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Moonbrew/CreationIcons/ICON_Creation_Name.png"); }

/* The panel: the pack's thin frame with fleurons at the corners, in violet, filling its texture */
.creation-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 40px 44px 22px 44px;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_13_Mask.png?fileID=21300000&guid=8e240ae2faf21a6499a399e48ec11e04&type=3#SPR_FantasyMenus_Frame_Box_Large_13_Mask");
    -unity-background-image-tint-color: rgba(24, 15, 62, 0.94);
    -unity-slice-scale: 0.2px;
    font-size: 24px;
    color: rgb(240, 234, 255);
}

.creation-panel .window__lip {
    display: none;
}

.creation-panel .window__frame {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Frame_Box_Large_13.png?fileID=21300000&guid=ec2724f6bf9476d4b8490f5c62a02ffd&type=3#SPR_FantasyMenus_Frame_Box_Large_13");
    -unity-slice-scale: 0.2px;
}

.panel-page {
    flex-grow: 1;
    display: none;
}

.colour-section {
    display: none;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.panel-page--shown {
    display: flex;
}

.panel-scroll {
    flex-grow: 1;
}

.panel-scroll .unity-scroller--vertical {
    width: 10px;
}

.panel-scroll .unity-scroller__low-button,
.panel-scroll .unity-scroller__high-button {
    display: none;
}

.panel-scroll .unity-base-slider__tracker {
    background-color: rgba(10, 6, 26, 0.8);
    border-color: rgb(176, 140, 64);
}

.panel-scroll .unity-base-slider__dragger {
    background-color: rgb(92, 60, 190);
    border-color: rgb(236, 200, 110);
}

.section-name {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 24px;
    color: rgb(240, 234, 255);
}

/* One cell per choice, with the choice drawn on the owner */
.grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* The pack's torn parchment tiles, three shapes in turn: only the chosen one lights up, inside the pack's torn white outline */
.cell {
    width: 136px;
    height: 132px;
    margin: 2px;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(13, 8, 36);
    -unity-slice-scale: 0.3px;
}

.cell--shape-0 {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Box_Small_Parchment_01.png?fileID=21300000&guid=d3f98c507aadb6b4facdfb43e54b14aa&type=3#SPR_FantasyMenus_Box_Small_Parchment_01");
}

.cell--shape-1 {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Box_Small_Parchment_02.png?fileID=21300000&guid=0aa7978b6eb231a4491db61d3d132c5c&type=3#SPR_FantasyMenus_Box_Small_Parchment_02");
}

.cell--shape-2 {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Box_Small_Parchment_03.png?fileID=21300000&guid=64d4736c8b159b74695478fa959043d2&type=3#SPR_FantasyMenus_Box_Small_Parchment_03");
}

.cell:hover {
    -unity-background-image-tint-color: rgb(44, 28, 100);
}

.cell--selected,
.cell--selected:hover {
    -unity-background-image-tint-color: rgb(112, 72, 232);
}

.cell__image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cell__outline {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Frame_Box_Small_01.png?fileID=21300000&guid=b87f9e31786b3b74694e8da5f5e24eb4&type=3#SPR_FantasyMenus_Frame_Box_Small_01");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    -unity-slice-scale: 0.15px;
}

.cell--selected .cell__outline {
    display: flex;
}

/* "None": the pack's ring crossed by a bar, in gold */
.cell__none {
    position: absolute;
    left: 26px;
    top: 22px;
    width: 84px;
    height: 84px;
    align-items: center;
    justify-content: center;
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/General/SPR_FantasyMenus_Ring_Medium_11.png?fileID=21300000&guid=cdafe566c114fa147a8669326768bf5a&type=3#SPR_FantasyMenus_Ring_Medium_11");
    -unity-background-image-tint-color: rgb(176, 140, 64);
}

.cell__none-bar {
    width: 72px;
    height: 8px;
    rotate: -45deg;
    background-color: rgb(176, 140, 64);
}

.creation__counter {
    align-self: flex-start;
    flex-shrink: 0;
    margin: 4px 0 0 0;
    padding: 2px 10px;
    font-size: 20px;
    color: rgb(217, 207, 245);
    background-color: rgba(10, 6, 26, 0.75);
}

/* Colours: a row of swatches per colour, as on the pack's colour screen */
.swatches {
    flex-direction: row;
    flex-wrap: wrap;
}

.swatch {
    width: 34px;
    height: 34px;
    margin: 3px;
    padding: 0;
    border-width: 2px;
    border-color: rgb(176, 140, 64);
    border-radius: 2px;
}

.swatch:hover {
    border-color: rgb(236, 200, 110);
}

.swatch--selected {
    border-width: 3px;
    border-color: rgb(255, 255, 255);
}

/* The outfit's own colours: a darker inner frame tells it apart from a dye */
.swatch--original {
    border-color: rgb(206, 190, 255);
    border-left-width: 6px;
    border-right-width: 6px;
}

/* Body gauges, as on the pack's body settings: the name on the left, the gauge and its two ends on the right */
.gauge-row {
    flex-direction: row;
    align-items: center;
    margin: 18px 0;
}

.gauge-row__name {
    width: 38%;
    margin: 0;
    font-size: 24px;
    color: rgb(206, 190, 255);
}

.gauge-row__gauge {
    flex-grow: 1;
}

.gauge-row__ends {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.gauge-row__ends Label {
    margin: 0;
    padding: 0;
    font-size: 18px;
    color: rgb(240, 234, 255);
}

.gauge {
    margin: 0 8px;
}

.gauge .unity-base-slider__tracker {
    height: 8px;
    margin-top: -4px;
    background-color: rgba(10, 6, 26, 0.85);
    border-width: 2px;
    border-color: rgb(176, 140, 64);
    border-radius: 0;
}

.gauge .unity-base-slider__dragger {
    width: 14px;
    height: 14px;
    margin-top: -7px;
    background-color: rgb(112, 72, 232);
    border-width: 2px;
    border-color: rgb(236, 200, 110);
    border-radius: 0;
    rotate: 45deg;
}

.gauge .unity-base-slider__dragger-border {
    display: none;
}

/* Name and start */
.name-field {
    margin: 0 0 24px 0;
    font-size: 24px;
    --unity-cursor-color: rgb(255, 255, 255);
    --unity-selection-color: rgba(112, 72, 232, 0.8);
}

/* The same box as the pronouns' */
.name-field .unity-base-field__input,
.name-field:hover .unity-base-field__input,
.name-field:focus .unity-base-field__input {
    padding: 6px 10px;
    color: rgb(255, 255, 255);
    background-color: rgba(10, 6, 26, 0.85);
    border-width: 2px;
    border-color: rgb(176, 140, 64);
    border-radius: 0;
}

.start {
    align-self: flex-start;
    min-width: 280px;
    font-size: 28px;
}

.start > .menu-item__label {
    color: rgb(236, 200, 110);
}

.start:hover > .menu-item__label {
    color: rgb(255, 236, 170);
}

.start:disabled {
    opacity: 1;
}

.start:disabled > .menu-item__label {
    color: rgb(158, 136, 222);
}

/* Pronouns: the choice between the pack's arrows, as on its player settings */
.choice-row {
    flex-direction: row;
    align-items: center;
    margin: 0 0 24px 0;
}

.choice-row__arrow {
    width: 30px;
    height: 30px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(236, 200, 110);
}

.choice-row__arrow:hover {
    -unity-background-image-tint-color: rgb(255, 236, 170);
}

.choice-row__arrow--previous {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Button_Arrow_01_Left.png");
}

.choice-row__arrow--next {
    background-image: url("project://database/Packages/com.moonbrew.synty/Packs/Synty/InterfaceFantasyMenus/Sprites/FantasyMenus/SPR_FantasyMenus_Button_Arrow_01_Right.png");
}

.choice-row__value {
    width: 220px;
    margin: 0 10px;
    padding: 6px 0;
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgba(10, 6, 26, 0.85);
    border-width: 2px;
    border-color: rgb(176, 140, 64);
}

/* The faint sky behind the owner: the title's sky in the middle of a wider strip of the same violet */
.creation-sky {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(50, 42, 118);
}

.creation-sky__middle {
    position: absolute;
    left: 320px;
    top: 0;
    width: 640px;
    height: 360px;
}
